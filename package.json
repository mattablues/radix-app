{
  "name": "radix",
  "version": "1.0.0",
  "description": "Radix System",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "watch:tailwind": "npx rimraf public/assets/css/app.css && npx @tailwindcss/cli -i resources/tailwind/index.css -o public/assets/css/app.css --watch",
    "watch:alpinejs": "npx rimraf public/assets/js/app.js && npx esbuild resources/js/index.js --outfile=public/assets/js/app.js --bundle --watch",
    "build:css": "npx @tailwindcss/cli -i resources/tailwind/index.css -o public/assets/css/app.css --optimize --minify",
    "build:js": "npx esbuild resources/js/index.js --outfile=public/assets/js/app.js --bundle --minify-syntax --minify-whitespace --target=es2020",
    "start:dev": "npm-run-all --parallel watch:tailwind watch:alpinejs",
    "start:build": "npm-run-all build:js build:css",
    "toc": "doctoc README.md --maxlevel 3"
  },
  "author": "Mats Åkebrand",
  "license": "MIT",
  "devDependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@alpinejs/csp": "^3.15.12",
    "@alpinejs/focus": "^3.15.12",
    "@alpinejs/ui": "^3.15.12",
    "@imacrayon/alpine-ajax": "^0.12.7",
    "@tailwindcss/cli": "^4.3.0 ",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.5.0",
    "doctoc": "^2.4.1",
    "esbuild": "^0.28.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.0": true
  }
}
