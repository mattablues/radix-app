{% extends "layouts/app.ratio.php" %}
{% block title %}Dashboard | Radix Control{% endblock %}
{% block pageId %}dashboard{% endblock %}

{% block body %}
  <section>
    <div class="mb-8">
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Dashboard</h1>
      <p class="text-slate-500">
        Snabbåtkomst till det du oftast behöver.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-4">
        <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
          <div class="flex items-start justify-between gap-6">
            <div class="min-w-0">
              <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Inloggad som</p>
              <h2 class="mt-2 text-2xl font-black text-slate-900 truncate">
                {{ $currentUser->getAttribute('first_name') }} {{ $currentUser->getAttribute('last_name') }}
              </h2>
              <p class="mt-2 text-sm text-slate-600">
                Du kan öppna medlemschatten nere till höger och fortsätta där du var sist.
              </p>
            </div>

            <a
              href="{{ route('user.index') }}"
              class="shrink-0 inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-black uppercase tracking-[0.22em] text-white hover:bg-slate-800 transition"
            >
              Min profil
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <div class="rounded-3xl border border-indigo-200 bg-indigo-50/60 p-7">
          <p class="text-[10px] font-black uppercase tracking-[0.22em] text-indigo-700">Snabbstart</p>

          <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a
              href="{{ route('user.edit') }}"
              class="group flex items-center justify-between rounded-2xl bg-white border border-slate-200 px-4 py-4 hover:border-indigo-300 hover:bg-indigo-50/40 transition"
            >
              <div>
                <div class="text-sm font-black text-slate-900">Uppdatera profil</div>
                <div class="mt-1 text-xs text-slate-500">Namn, avatar och inställningar</div>
              </div>
              <span class="text-indigo-700 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </a>

            <a
              href="{{ route('contact.index') }}"
              class="group flex items-center justify-between rounded-2xl bg-white border border-slate-200 px-4 py-4 hover:border-indigo-300 hover:bg-indigo-50/40 transition"
            >
              <div>
                <div class="text-sm font-black text-slate-900">Kontakta support</div>
                <div class="mt-1 text-xs text-slate-500">Frågor eller problem</div>
              </div>
              <span class="text-indigo-700 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <aside class="space-y-4">
        <h2 class="text-xl font-bold text-slate-800">Genvägar</h2>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="space-y-2">
            <a href="{{ route('user.index') }}" class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-indigo-700 transition">
              Min profil
            </a>
            <a href="{{ route('user.edit') }}" class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-indigo-700 transition">
              Redigera profil
            </a>

            {% if($currentUser->hasAtLeast('moderator')) : %}
              <div class="pt-3 mt-3 border-t border-slate-200">
                <p class="px-4 pb-2 text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">
                  Administration
                </p>

                <a href="{{ route('admin.system.index') }}" class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-indigo-700 transition">
                  Systemöversikt
                </a>
                <a href="{{ route('admin.system-event.index') }}" class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-indigo-700 transition">
                  Händelselogg
                </a>
                <a href="{{ route('admin.system-update.index') }}" class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-indigo-700 transition">
                  Uppdateringar
                </a>
                <a href="{{ route('admin.user.index') }}" class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-indigo-700 transition">
                  Användare
                </a>
              </div>
            {% endif; %}
          </div>

          <p class="mt-4 text-xs text-slate-500">
            All navigation finns även i menyn till vänster – detta är bara snabbåtkomst.
          </p>
        </div>
      </aside>
    </div>
  </section>
{% endblock %}
